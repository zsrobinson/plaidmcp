PLAID_CLIENT_ID=<client-id>
PLAID_SECRET=<secret>
PLAID_ENV=sandbox
PLAIDMCP_PRIVATE=/var/lib/plaidmcp-private
PLAIDMCP_PUBLIC=/var/lib/plaidmcp/aggregate.sqlite
PLAIDMCP_VENMO_IMPORT_DIR=/var/lib/plaidmcp-private/import/venmo
PLAIDMCP_VENMO_PROCESSED=delete
# For explicit raw archival only: PLAIDMCP_VENMO_PROCESSED=move
# PLAIDMCP_VENMO_ARCHIVE=/var/lib/plaidmcp-private/processed/venmo
# Optional JSON mapping, e.g. PLAIDMCP_VENMO_COLUMN_MAP='{"date":"Posted On","amount":"Net USD","type":"Kind"}'
# Nonzero fee columns require explicit semantics: separate (fee in addition to total)
# or included (fee already deducted/included in signed total). Reject by default.
PLAIDMCP_VENMO_FEE_MODE=reject

# Both sync publication and server must opt in to last-four display.
PLAIDMCP_INCLUDE_LAST_FOUR=false
# 1 disables folding; higher thresholds fold small activity/position groups into Other.
PLAIDMCP_MIN_GROUP_COUNT=1
PLAIDMCP_STALE_HOURS=24
# Optional comma-separated opaque ids from list_sources, to hide/stop sources locally.
PLAIDMCP_DISABLED_SOURCES=
PLAIDMCP_SANDBOX_ONLY=true

# Optional stable opaque account ids from list_accounts; unknown ids fail publication.
# Classified privately at sync; tools default to scope=all.
PLAIDMCP_SEPARATE_ACCOUNTS=
