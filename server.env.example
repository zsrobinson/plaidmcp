PLAIDMCP_PUBLIC=/var/lib/plaidmcp/aggregate.sqlite
ACCESS_TEAM_DOMAIN=<team>.cloudflareaccess.com
ACCESS_AUD=<application-audience>

# Both sync publication and server must opt in to last-four display.
PLAIDMCP_INCLUDE_LAST_FOUR=false
# 1 disables folding; higher thresholds fold small activity/position groups into Other.
PLAIDMCP_MIN_GROUP_COUNT=1
PLAIDMCP_STALE_HOURS=24
# Optional comma-separated opaque ids from list_sources, to hide/stop sources locally.
PLAIDMCP_DISABLED_SOURCES=
PLAIDMCP_PUBLIC_HOST=plaidmcp.example.com
PLAIDMCP_REQUIRE_ACCESS=true
